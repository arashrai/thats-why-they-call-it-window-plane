PORT=3000
AIRCRAFT_JSON_PATH=/run/readsb/aircraft.json

HOME_LAT=47.xxxxxx
HOME_LON=-122.xxxxxx
HOME_ELEVATION_FT=350

WINDOW_CENTER_AZIMUTH_DEG=160
WINDOW_HALF_WIDTH_DEG=65

MAX_DISTANCE_NM=25
MIN_ELEVATION_ANGLE_DEG=1
MAX_ELEVATION_ANGLE_DEG=75

# Room-relative arrow calibration:
# FRONT_BEARING_DEG is the bearing of the TV/front window.
# RIGHT_BEARING_DEG is the bearing of the right window.
# In screen coordinates: 0deg = right, 90deg = down.
FRONT_BEARING_DEG=120
RIGHT_BEARING_DEG=200
FRONT_UI_ANGLE_DEG=90
RIGHT_UI_ANGLE_DEG=0