# Northeast-facing first guess.
WINDOW_CENTER_AZIMUTH_DEG=45
WINDOW_HALF_WIDTH_DEG=55

MAX_DISTANCE_NM=25
MIN_ELEVATION_ANGLE_DEG=1
MAX_ELEVATION_ANGLE_DEG=75