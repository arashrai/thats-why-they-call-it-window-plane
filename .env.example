PORT=3000
AIRCRAFT_JSON_PATH=/run/readsb/aircraft.json

HOME_LAT=47.xxxxxx
HOME_LON=-122.xxxxxx
HOME_ELEVATION_FT=350

MAX_DISTANCE_NM=30
MIN_ELEVATION_ANGLE_DEG=0
MAX_ELEVATION_ANGLE_DEG=85

# Projection calibration:
# The compass bearing that corresponds to "look straight down from the ceiling projection
# toward the TV/front window."
DOWN_BEARING_DEG=120

# 1.0 means a 10° bearing change creates a 10° arrow rotation change.
# Increase if the arrow feels too subtle; decrease if it moves too aggressively.
BEARING_TO_UI_SCALE=1