PORT=3000
AIRCRAFT_JSON_PATH=/run/readsb/aircraft.json

HOME_LAT=47.xxxxxx
HOME_LON=-122.xxxxxx
HOME_ELEVATION_FT=350

# Never show selected aircraft farther than this.
MAX_DISTANCE_KM=10

# Projection calibration:
# Bearing 120° should point straight down on the ceiling projection.
DOWN_BEARING_DEG=120

# 1.0 means a 10° bearing change creates a 10° arrow rotation change.
# Deprecated: We now use a true 3D perspective projection model.
BEARING_TO_UI_SCALE=1

# Physical vertical distance from projector lens to ceiling (in feet)
CEILING_HEIGHT_FT=8.0

# Physical radius of the projected radar circle on the ceiling (in feet)
RADAR_RADIUS_FT=2.0