[Unit]
Description=Window Plane Web App
After=network-online.target readsb.service
Wants=network-online.target readsb.service

[Service]
Type=simple
User=arash
WorkingDirectory=/home/arash/projects/thats-why-they-call-it-window-plane
EnvironmentFile=-/home/arash/projects/thats-why-they-call-it-window-plane/.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target